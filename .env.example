CHEMPBOARD_IMAGE=ghcr.io/chempner/chempboard:latest
HOST_PORT=8091
JWT_SECRET=CHANGE_ME_same_secret_as_auth_manager
AUTH_SERVICE_URL=http://host.docker.internal:3100
AUTH_SERVICE_PUBLIC_URL=http://localhost:3100
SECURE_COOKIES=true

NAS_PUBLIC_URL=
NAS_PROC_PATH=/host/proc
NAS_DISK_PATHS=/data,/host/mnt
NAS_LOG_FILES=
DOCKER_SOCKET=/var/run/docker.sock

HOME_ASSISTANT_URL=http://homeassistant.local:8123
HOME_ASSISTANT_TOKEN=
HA_LOGBOOK_HOURS=24

UNIFI_URL=https://unifi.local
UNIFI_USERNAME=
UNIFI_PASSWORD=
UNIFI_API_KEY=
UNIFI_SITE=default
UNIFI_INSECURE=true
UNIFI_LOGIN_PATHS=/api/auth/login,/api/login
UNIFI_API_PREFIXES=/proxy/network,

STATUS_SITES=[{"name":"Home Assistant","url":"http://homeassistant.local:8123","group":"Home","kind":"homeassistant"},{"name":"Father Network","url":"https://father-network.example.com","group":"Family","kind":"network"}]
